# Copy to .env and replace every value. .env is never committed.
# The values below are placeholders that pass the API's checks, so CI can copy this file as it is.

POSTGRES_PASSWORD=change-me-local-only

# Signs the access tokens. At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# The first administrator, `admin`. Used only while nobody can manage access. 10 to 72 characters.
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-0001

# End-to-end suites on a developer's machine or in CI only. Never in production.
# With the profile e2e the API keeps the administrator `e2e-admin` with this password (docs/rules/testing.md).
SPRING_PROFILES_ACTIVE=e2e
E2E_ADMIN_PASSWORD=change-me-e2e-0001
